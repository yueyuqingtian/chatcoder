# chatcoder 环境配置示例（复制为 server/.env 后按需修改）

# ---- 服务端 ----
# 桌面版由 Electron 固定监听 127.0.0.1（默认 12973，占用时顺延）；以下仅作用于源码开发
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# ---- 数据库 ----
# 本项目自身使用 SQLite 单文件存储，无需安装任何数据库服务。
# 桌面版会强制使用 %LOCALAPPDATA%/chatcoder/chatcoder.db；此处的相对路径只影响源码开发。
DATABASE_URL=sqlite+aiosqlite:///./chatcoder.db

# ---- 缓存 / 向量库 ----
# 当前版本不依赖 Redis 与 Qdrant，无需配置。

# ---- 默认模型（服务端内置，开箱即用）----
# 留空则默认模型不可用，用户需要在界面里配置 BYOK
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_BASE_URL=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=

# ---- JWT 鉴权 ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- 工具执行与调度 ----
# 工作区根目录（文件工具与终端命令的沙箱边界）
WORKSPACE_ROOT=./workspace
# 计划确认门：true=拆解后自动开跑；false（默认）=需用户确认后才执行
AUTO_CONFIRM_PLAN=false
# 审批超时（秒），超时自动拒绝
APPROVAL_TIMEOUT_SEC=300

# ---- ta3（Ta+3 牛码）供应商 ----
# LLM 请求 User-Agent 伪装（模拟参考项目运行环境，防风控）
# 留空使用内置默认 UA
TA3_USER_AGENT=
