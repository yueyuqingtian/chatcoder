# chatcoder 环境配置示例（复制为 .env 后填写真实值）

# ---- 服务端 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# ---- 数据库 ----
DATABASE_URL=postgresql+asyncpg://chatcoder:chatcoder_dev@localhost:5432/chatcoder

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant 向量库 ----
QDRANT_URL=http://localhost:6333

# ---- 默认模型（服务端内置，开箱即用）----
# 留空则默认模型不可用，用户必须配置 BYOK
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_BASE_URL=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=

# ---- JWT 鉴权 ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- v0.3:工具执行与调度 ----
# 工作区根目录(服务端工具执行沙箱边界,fs.* / terminal.* 受限于此)
WORKSPACE_ROOT=./workspace
# 计划确认门 — true=拆解后自动开跑;false(默认)=需用户确认后才调度
AUTO_CONFIRM_PLAN=false
# 审批超时(秒),用户未响应自动拒绝
APPROVAL_TIMEOUT_SEC=300
# agent loop 单任务最大步数
AGENT_MAX_STEPS=8
