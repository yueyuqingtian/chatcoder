{
  "name": "chatcoder",
  "version": "0.7.0",
  "description": "chatcoder - AI 多 Agent 协同编码工作台(桌面版)",
  "author": "chatcoder",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron electron/main.cjs",
    "build:frontend": "cd client && npm run build",
    "build:backend": "cd server && .venv\\Scripts\\pyinstaller.exe chatcoder-server.spec --noconfirm --clean",
    "build:all": "npm run build:frontend && npm run build:backend && npm run dist",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "postinstall": "electron-rebuild -f -w node-pty || echo electron-rebuild skipped"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "build": {
    "appId": "com.chatcoder.desktop",
    "productName": "chatcoder",
    "copyright": "Copyright © 2026 chatcoder",
    "directories": {
      "output": "v7",
      "buildResources": "electron/build"
    },
    "npmRebuild": false,
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/pty.cjs",
      "electron/loading.html",
      "electron/glass-diagnostics.cjs",
      "electron/liquid-glass.cjs",
      "electron/pet.cjs",
      "electron/pet-preload.cjs",
      "package.json",
      "node_modules/node-pty/**",
      "node_modules/koffi/**",
      "node_modules/@hicccc77/electron-liquid-glass/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/koffi/**",
      "node_modules/@hicccc77/electron-liquid-glass/**/*"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "frontend"
      },
      {
        "from": "server/dist/chatcoder-server",
        "to": "server/chatcoder-server"
      },
      {
        "from": "server/dist/chatcoder-index-worker",
        "to": "server/chatcoder-server"
      },
      {
        "from": "server/.env",
        "to": "server/chatcoder-server/.env"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "electron/build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "electron/build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "chatcoder",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yueyuqingtian",
        "repo": "chatcoder"
      }
    ]
  },
  "dependencies": {
    "@hicccc77/electron-liquid-glass": "^0.4.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3"
  }
}
